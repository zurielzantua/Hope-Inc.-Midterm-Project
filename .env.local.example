NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key

# Enable only after the DB Admin deploys/tests the RLS and claim migrations and verifies Auth email settings.
HOPE_FIRST_PASSWORD_SETUP_ENABLED=false
HOPE_APP_URL=http://127.0.0.1:3000

# An existing HOPE table for the read-only connection check.
SUPABASE_CHECK_TABLE=product
